[user]
    name = Jianyu Huang
    email = hjyahead@gmail.com
[core]
    editor = vim
    whitespace = fix,-indent-with-non-tab,trailing-sp-t-eol
    excludesfile = ~/.gitignore
[color]
    ui = auto
[color "branch"]
    current = yellow bold
    local = green bold
    remote = cyan bold
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse
[color "status"]
    added = green bold
    changed = yellow bold
    untracked = red bold
[diff]
    tool = vimdiff
